{
  "name": "outside_orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "npm run build && node --test dist/tests/*.test.js dist/tests/acceptance/*.test.js",
    "check": "npm run build",
    "rehearse:dr": "npm run build && node dist/scripts/disaster-recovery-rehearsal.js",
    "lint:policy": "npm run build && node dist/scripts/lint-policy.js",
    "deploy": "bash scripts/deploy.sh"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^5.6.2"
  }
}
