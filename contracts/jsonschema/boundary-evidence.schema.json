{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maulsparks/Outside_Orchestrator/contracts/jsonschema/boundary-evidence.schema.json",
  "title": "BoundaryEvidence",
  "type": "object",
  "required": [
    "evidence_id",
    "run_id",
    "request_id",
    "sequence",
    "event_type",
    "observed_at",
    "source_identity",
    "policy_version",
    "payload_sha256",
    "event_hash",
    "signing_key_id",
    "warden_signature"
  ],
  "properties": {
    "evidence_id": { "type": "string" },
    "run_id": { "type": "string" },
    "request_id": { "type": "string" },
    "arm_id": { "type": "string" },
    "sandbox_id": { "type": "string" },
    "exe_vm_id": { "type": "string" },
    "tailscale_node_id": { "type": "string" },
    "phase": { "enum": ["plan", "build", "test", "review", "document"] },
    "phase_attempt": { "type": "integer", "minimum": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "event_type": {
      "enum": [
        "sandbox_creation_requested",
        "sandbox_created",
        "tailscale_enrollment_observed",
        "delegation_issued",
        "credential_issued",
        "command_observed",
        "tree_observed",
        "network_decision_observed",
        "advisory_output_collected",
        "erg_result",
        "test_result",
        "credential_revoked",
        "tailscale_logout_requested",
        "tailscale_node_deauthorized",
        "tailscale_node_absence_confirmed",
        "exe_vm_destroy_requested",
        "exe_vm_destroyed",
        "teardown_probe_passed",
        "teardown_probe_failed",
        "sandbox_destroyed",
        "teardown_failed"
      ]
    },
    "observed_at": { "type": "string", "format": "date-time" },
    "source_identity": { "type": "string" },
    "policy_version": { "type": "string" },
    "payload_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "previous_event_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "event_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "signing_key_id": { "type": "string" },
    "warden_signature": { "type": "string" }
  },
  "additionalProperties": false
}
